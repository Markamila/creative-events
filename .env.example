# ───── Обязательно ─────
# Строка подключения к PostgreSQL (в docker compose задаётся автоматически)
DATABASE_URL=postgres://creative:creative_local_pw@localhost:5432/creative_events
# Длинная случайная строка для подписи сессий: openssl rand -hex 32
JWT_SECRET=
# Данные первого администратора (создаётся при первом запуске). Пароль — не короче 10 символов.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ───── Рекомендуется ─────
# Публичный адрес сайта без слэша в конце — для ссылок в уведомлениях, canonical и sitemap
PUBLIC_URL=http://localhost:3000
NODE_ENV=production
PORT=3000
# true — если база требует SSL (внешние хостинги БД)
DATABASE_SSL=false
DB_PASSWORD=creative_local_pw

# ───── Уведомления менеджеру: Telegram (рекомендуется) ─────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ───── Уведомления менеджеру: e-mail (SMTP) ─────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MANAGER_EMAIL=

# Лимит заявок с одного IP за 15 минут
REQUEST_RATE_LIMIT=6
